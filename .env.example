# Desktop client configuration template.
# Copy to .env for local development. Never commit a real token.
#
# Env vars always win over .env values. Run with no token to use the
# capture-only skeleton (no network calls).

# Backend origins.
DESKTOP_API_BASE_URL=http://127.0.0.1:8000
DESKTOP_WS_BASE_URL=ws://127.0.0.1:8000

# Short-lived JWT from the backend auth flow. Optional for interactive use:
# without it the client opens the browser login (portal handoff) on startup.
# Setting it explicitly keeps the previous behavior for dev/test runs.
DESKTOP_ACCESS_TOKEN=

# Optional rotating refresh credentials (from POST /auth/{provider}/token or
# the portal handoff). When set, the client refreshes the access token shortly
# before it expires, on HTTP 401, and once on a 4401 WebSocket rejection.
DESKTOP_REFRESH_TOKEN=
DESKTOP_DEVICE_ID=

# Interactive browser login. Disable to force capture-only mode when no token
# is configured (equivalent to --no-login).
DESKTOP_LOGIN_ENABLED=1
# Portal entry point. Defaults to <api_base_url>/web/desktop-login.
# DESKTOP_AUTH_PORTAL_URL=
# Exact loopback redirect for the desktop's own handoff listener. Use a free
# port; do NOT use 8000 — the backend serves the portal's OIDC callback there
# (http://127.0.0.1:8000/web/auth/callback). When unset the client binds an
# ephemeral port and uses http://127.0.0.1:<port>/callback.
# DESKTOP_OIDC_REDIRECT_URI=http://127.0.0.1:8765/callback
# DESKTOP_OAUTH_SCOPE=openid profile email
# DESKTOP_LOGIN_TIMEOUT=120
# Device label sent to the backend. Defaults to the machine hostname.
# DESKTOP_DEVICE_NAME=

# Reuse an existing session instead of creating one. Optional: without it the
# client runs policy -> preflight -> create (or adopts an active session).
DESKTOP_SESSION_ID=
DESKTOP_GOAL_ID=

# Stream an answer after every transcript final (interviewer turns, gated).
DESKTOP_AUTO_ANSWER=0

# Seconds to wait after the last interviewer final before auto-answering.
# Increase if the interviewer often pauses mid-question and the client answers
# too early (STT can finalize on short pauses). 0 answers immediately.
DESKTOP_AUTO_ANSWER_DELAY_SECONDS=1.5

# mic | loopback | both. Sent as ?source= on the /audio socket and selects capture:
#   mic      = microphone (speaker="candidate")
#   loopback = system/output audio on Windows via WASAPI (speaker="interviewer")
#   both     = mic + loopback simultaneously (two streams; recommended for hearing
#              the interviewer while still capturing your mic). Windows only for
#              loopback; use headphones to avoid feedback/leakage.
DESKTOP_AUDIO_SOURCE=mic

# /events heartbeat cadence. The server closes after 65 s of client silence.
DESKTOP_HEARTBEAT_SECONDS=20

# Per-request HTTP timeout.
DESKTOP_REQUEST_TIMEOUT=30

# Headless/device-less verification only. Prefer the --simulate-audio CLI flag.
DESKTOP_SIMULATE_AUDIO=0

# Speech-to-text provider.
#   backend   = stream PCM over /audio WS; backend STT produces transcript finals (default)
#   moonshine = local Moonshine STT; posts finalized turns to POST /transcript/turns
# Moonshine mode requires: pip install moonshine-voice and a backend exposing /transcript/turns.
DESKTOP_STT_PROVIDER=backend
DESKTOP_MOONSHINE_LANGUAGE=en
# DESKTOP_MOONSHINE_MODEL=
